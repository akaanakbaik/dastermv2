#!/usr/bin/env bash
set -uo pipefail
IFS=$' \t\n'

DASTERM_BINARY="${BASH_SOURCE[0]}"
while [ -L "$DASTERM_BINARY" ]; do
  _link="$(readlink "$DASTERM_BINARY")"
  case "$_link" in
    /*) DASTERM_BINARY="$_link" ;;
    *) DASTERM_BINARY="$(dirname "$DASTERM_BINARY")/$_link" ;;
  esac
done
DASTERM_BINARY="$(cd "$(dirname "$DASTERM_BINARY")" && pwd)/$(basename "$DASTERM_BINARY")"
DASTERM_INSTALL_PREFIX="$(cd "$(dirname "$DASTERM_BINARY")/.." && pwd)"
DASTERM_PREFIX="${DASTERM_PREFIX:-$DASTERM_INSTALL_PREFIX/share/dasterm}"
if [ ! -f "$DASTERM_PREFIX/lib/core.sh" ] && [ -f "$DASTERM_INSTALL_PREFIX/lib/core.sh" ]; then
  DASTERM_PREFIX="$DASTERM_INSTALL_PREFIX"
fi
DASTERM_LIB="${DASTERM_PREFIX}/lib"
DASTERM_HOME="${HOME}"
DASTERM_CONFIG_DIR="${XDG_CONFIG_HOME:-$DASTERM_HOME/.config}/dasterm"
DASTERM_CACHE_DIR="${XDG_CACHE_HOME:-$DASTERM_HOME/.cache}/dasterm"
DASTERM_DATA_DIR="${XDG_DATA_HOME:-$DASTERM_HOME/.local/share}/dasterm"
DASTERM_LOG_DIR="${DASTERM_DATA_DIR}/logs"
DASTERM_CONFIG="${DASTERM_CONFIG_DIR}/config.env"
DASTERM_VERSION_FALLBACK="2.0.1"

if [ ! -r "$DASTERM_LIB/core.sh" ] || [ ! -r "$DASTERM_LIB/i18n.sh" ]; then
  printf 'Dasterm: missing libraries at %s; reinstall or set DASTERM_PREFIX.\n' "$DASTERM_LIB" >&2
  exit 1
fi
. "$DASTERM_LIB/core.sh"
[ -f "${DASTERM_LIB}/i18n.sh" ] && . "${DASTERM_LIB}/i18n.sh"

dasterm_bootstrap_minimal() {
  mkdir -p "$DASTERM_CONFIG_DIR" "$DASTERM_CACHE_DIR" "$DASTERM_LOG_DIR"

  if [ ! -f "$DASTERM_CONFIG" ]; then
    cat > "$DASTERM_CONFIG" <<EOF
DASTERM_VERSION="$DASTERM_VERSION_FALLBACK"
DASTERM_LANG="id"
DASTERM_MODE="lite"
DASTERM_THEME="pastel"
DASTERM_USERHOST="$(whoami)@$(hostname 2>/dev/null || echo linux)"
DASTERM_SHOW="always"
DASTERM_PROMPT="on"
DASTERM_SLASH="on"
DASTERM_TELEMETRY="off"
DASTERM_REPO_OWNER="akaanakbaik"
DASTERM_REPO_NAME="dastermv2"
DASTERM_REPO_BRANCH="main"
EOF
    chmod 600 "$DASTERM_CONFIG"
  fi
}

dasterm_load_all() {
  dasterm_bootstrap_minimal

  if [ -f "$DASTERM_CONFIG" ]; then
    . "$DASTERM_CONFIG"
  fi

  local f
  for f in render system network speedtest update storage security services doctor telemetry; do
    if [ -f "${DASTERM_LIB}/${f}.sh" ]; then
      . "${DASTERM_LIB}/${f}.sh"
    fi
  done
}

dasterm_shell_init() {
  dasterm_bootstrap_minimal

  if [ -f "$DASTERM_CONFIG" ]; then
    . "$DASTERM_CONFIG"
  fi

  local shell_type="${1:-bash}"

  if [ "${DASTERM_PROMPT:-on}" = "on" ]; then
    local uh
    uh="${DASTERM_USERHOST:-$(whoami)@$(hostname 2>/dev/null || echo linux)}"
    # Keep custom text in a variable so shell prompt expansion never evaluates
    # command substitutions embedded in the configured label.
    printf 'export DASTERM_PROMPT_LABEL=%q\n' "$uh"

    if [ "$shell_type" = "zsh" ]; then
      printf "setopt promptsubst\nexport PS1='%%{\\033[1;32m%%}\${DASTERM_PROMPT_LABEL}%%{\\033[0m%%}:%%{\\033[1;34m%%}%%~%%{\\033[0m%%}%%# '\n"
    else
      printf "export PS1='\\[\\033[1;32m\\]\${DASTERM_PROMPT_LABEL}\\[\\033[0m\\]:\\[\\033[1;34m\\]\\w\\[\\033[0m\\]\\$ '\n"
    fi
  fi

  if [ "${DASTERM_SLASH:-on}" = "on" ]; then
    local name target
    while IFS=: read -r name target; do
      [ -n "$name" ] || continue
      # Bash rejects slashes in alias names, but accepts function names here.
      printf 'function /%s { %q %q "$@"; }\n' "$name" "$DASTERM_BINARY" "$target"
    done <<'EOF'
help:help
status:status
lite:lite
full:full
speedtest:speedtest
respeedtest:respeedtest
network:network
storage:storage
services:services
security:security
doctor:doctor
config:config
update:update
uninstall:uninstall
version:version
about:about
watch:watch
EOF
  fi
}

dasterm_help() {
  dasterm_load_all
  dasterm_title "$(dasterm_t help_title)"
  dasterm_kv "/help" "$(dasterm_t help_help)"
  dasterm_kv "/status" "$(dasterm_t help_status)"
  dasterm_kv "/lite" "$(dasterm_t help_lite)"
  dasterm_kv "/full" "$(dasterm_t help_full)"
  dasterm_kv "/speedtest" "$(dasterm_t help_speedtest)"
  dasterm_kv "/respeedtest" "$(dasterm_t help_respeedtest)"
  dasterm_kv "/network" "$(dasterm_t help_network)"
  dasterm_kv "/storage" "$(dasterm_t help_storage)"
  dasterm_kv "/services" "$(dasterm_t help_services)"
  dasterm_kv "/security" "$(dasterm_t help_security)"
  dasterm_kv "/doctor" "$(dasterm_t help_doctor)"
  dasterm_kv "/config" "$(dasterm_t help_config)"
  dasterm_kv "/update" "$(dasterm_t help_update)"
  dasterm_kv "/uninstall" "$(dasterm_t help_uninstall)"
  dasterm_kv "/version" "$(dasterm_t help_version)"
  dasterm_kv "/about" "$(dasterm_t help_about)"
  dasterm_kv "/watch" "$(dasterm_t help_watch)"
  dasterm_footer
}

dasterm_config_menu() {
  dasterm_load_all

  local lang mode theme show prompt slash telemetry uh ans
  lang="${DASTERM_LANG:-id}"
  mode="${DASTERM_MODE:-lite}"
  theme="${DASTERM_THEME:-pastel}"
  show="${DASTERM_SHOW:-always}"
  prompt="${DASTERM_PROMPT:-on}"
  slash="${DASTERM_SLASH:-on}"
  telemetry="${DASTERM_TELEMETRY:-off}"
  uh="${DASTERM_USERHOST:-$(whoami)@$(hostname 2>/dev/null || echo linux)}"

  dasterm_title "$(dasterm_t config_title)"

  echo "1) Indonesia"
  echo "2) English"
  read -r -p "Language [${lang}]: " ans
  case "${ans:-}" in
    1) lang="id" ;;
    2) lang="en" ;;
  esac

  echo "1) Lite"
  echo "2) Full"
  read -r -p "Mode [${mode}]: " ans
  case "${ans:-}" in
    1) mode="lite" ;;
    2) mode="full" ;;
  esac

  echo "1) Pastel"
  echo "2) Cyber"
  echo "3) Ocean"
  echo "4) Mono"
  read -r -p "Theme [${theme}]: " ans
  case "${ans:-}" in
    1) theme="pastel" ;;
    2) theme="cyber" ;;
    3) theme="ocean" ;;
    4) theme="mono" ;;
  esac

  read -r -p "User@Host [${uh}]: " ans
  [ -n "${ans:-}" ] && uh="$ans"

  read -r -p "Show dashboard every login? [${show}] always/manual: " ans
  case "${ans:-}" in
    always|manual) show="$ans" ;;
  esac

  read -r -p "Change prompt? [${prompt}] on/off: " ans
  case "${ans:-}" in
    on|off) prompt="$ans" ;;
  esac

  read -r -p "Enable slash commands? [${slash}] on/off: " ans
  case "${ans:-}" in
    on|off) slash="$ans" ;;
  esac

  read -r -p "Anonymous telemetry? [${telemetry}] on/off: " ans
  case "${ans:-}" in
    on|off) telemetry="$ans" ;;
  esac

  mkdir -p "$DASTERM_CONFIG_DIR"

  dasterm_save_config_value "DASTERM_VERSION" "${DASTERM_VERSION:-$DASTERM_VERSION_FALLBACK}"
  dasterm_save_config_value "DASTERM_LANG" "$lang"
  dasterm_save_config_value "DASTERM_MODE" "$mode"
  dasterm_save_config_value "DASTERM_THEME" "$theme"
  dasterm_save_config_value "DASTERM_USERHOST" "$uh"
  dasterm_save_config_value "DASTERM_SHOW" "$show"
  dasterm_save_config_value "DASTERM_PROMPT" "$prompt"
  dasterm_save_config_value "DASTERM_SLASH" "$slash"
  dasterm_save_config_value "DASTERM_TELEMETRY" "$telemetry"
  dasterm_save_config_value "DASTERM_REPO_OWNER" "${DASTERM_REPO_OWNER:-akaanakbaik}"
  dasterm_save_config_value "DASTERM_REPO_NAME" "${DASTERM_REPO_NAME:-dastermv2}"
  dasterm_save_config_value "DASTERM_REPO_BRANCH" "${DASTERM_REPO_BRANCH:-main}"

  chmod 600 "$DASTERM_CONFIG"
  dasterm_success "$(dasterm_t config_saved)"
}

dasterm_uninstall_prompt() {
  dasterm_load_all

  local url tmp ans
  url="https://raw.githubusercontent.com/${DASTERM_REPO_OWNER:-akaanakbaik}/${DASTERM_REPO_NAME:-dastermv2}/${DASTERM_REPO_BRANCH:-main}/install.sh"

  dasterm_warn "$(dasterm_t uninstall_hint)"
  read -r -p "Continue? [y/N]: " ans

  case "${ans:-n}" in
    y|Y|yes|YES|Yes)
      if [ "$DASTERM_BINARY" = "$HOME/.local/bin/dasterm" ] && [ "$DASTERM_PREFIX" = "$HOME/.local/share/dasterm" ]; then
        local rc rc_tmp
        for rc in "$HOME/.bashrc" "$HOME/.zshrc"; do
          [ -f "$rc" ] || continue
          rc_tmp="$(mktemp "${rc}.XXXXXX")" || return 1
          sed '/^### DASTERM_V2_BEGIN ###$/,/^### DASTERM_V2_END ###$/d' "$rc" > "$rc_tmp"
          cat "$rc_tmp" > "$rc"
          rm -f "$rc_tmp"
        done
        rm -f "$HOME/.local/bin/dasterm" "$HOME/.local/bin/dashterm"
        rm -rf "$DASTERM_PREFIX" "$DASTERM_CONFIG_DIR" "$DASTERM_CACHE_DIR"
        return 0
      fi
      if ! command -v curl >/dev/null 2>&1; then
        dasterm_error "curl is required."
        return 1
      fi

      tmp="$(mktemp "${TMPDIR:-/tmp}/dasterm-uninstall.XXXXXX")" || return 1
      if ! curl --connect-timeout 5 --max-time 30 -fsSL "$url" -o "$tmp" || ! bash -n "$tmp"; then
        rm -f "$tmp"
        dasterm_error "Could not download a valid uninstaller."
        return 1
      fi
      chmod +x "$tmp"

      if [ "$(id -u)" -ne 0 ]; then
        if command -v sudo >/dev/null 2>&1; then
          sudo bash "$tmp" --uninstall
        else
          dasterm_error "sudo is required for uninstall."
          rm -f "$tmp"
          return 1
        fi
      else
        bash "$tmp" --uninstall
      fi

      rm -f "$tmp"
      ;;
  esac
}

dasterm_telemetry_send_internal() {
  dasterm_load_all

  local event="${1:-run}"

  if declare -F dasterm_telemetry_send >/dev/null 2>&1; then
    dasterm_telemetry_send "$event"
  fi
}

dasterm_dispatch() {
  local cmd="${1:-status}"
  shift || true

  case "$cmd" in
    shell-init)
      dasterm_shell_init "$@"
      ;;

    telemetry-send)
      dasterm_telemetry_send_internal "${1:-run}"
      ;;

    auto)
      dasterm_load_all
      [ "${DASTERM_SHOW:-always}" = "manual" ] && exit 0
      dasterm_telemetry_send_internal run
      dasterm_render_dashboard "${DASTERM_MODE:-lite}"
      ;;

    status|dashboard)
      dasterm_load_all
      dasterm_telemetry_send_internal run
      dasterm_render_dashboard "${DASTERM_MODE:-lite}"
      ;;

    lite)
      dasterm_load_all
      dasterm_telemetry_send_internal run
      dasterm_render_dashboard lite
      ;;

    full)
      dasterm_load_all
      dasterm_telemetry_send_internal run
      dasterm_render_dashboard full
      ;;

    help|-h|--help)
      dasterm_help
      ;;

    speedtest)
      dasterm_load_all
      dasterm_speedtest_show
      ;;

    respeedtest)
      dasterm_load_all
      dasterm_speedtest_run "$@" || return $?
      dasterm_telemetry_send_internal respeedtest
      ;;

    network)
      dasterm_load_all
      dasterm_network_show
      ;;

    storage)
      dasterm_load_all
      dasterm_storage_show
      ;;

    services)
      dasterm_load_all
      dasterm_services_show
      ;;

    security)
      dasterm_load_all
      dasterm_security_show
      ;;

    doctor)
      dasterm_load_all
      dasterm_doctor_show
      dasterm_telemetry_send_internal doctor
      ;;



    config)
      dasterm_config_menu
      ;;

    update)
      dasterm_load_all
      dasterm_update_run
      ;;

    uninstall)
      dasterm_uninstall_prompt
      ;;

    version|--version|-v)
      dasterm_load_all
      echo "${DASTERM_VERSION:-$DASTERM_VERSION_FALLBACK}"
      ;;

    about)
      dasterm_load_all
      dasterm_title "Dasterm v2"
      dasterm_kv "Author" "aka"
      dasterm_kv "Repo" "github.com/akaanakbaik/dastermv2"
      dasterm_kv "Version" "${DASTERM_VERSION:-$DASTERM_VERSION_FALLBACK}"
      dasterm_footer
      ;;

    watch)
      dasterm_load_all
      local mode="${1:-${DASTERM_MODE:-lite}}"
      local interval="${2:-3}"
      case "$mode" in lite|full) ;; *) dasterm_error "Mode must be lite or full"; return 1 ;; esac
      if ! [[ "$interval" =~ ^[0-9]+([.][0-9]+)?$ ]] || ! awk -v n="$interval" 'BEGIN {exit !(n>0)}'; then
        dasterm_error "Interval must be greater than zero"
        return 1
      fi
      dasterm_theme_load
      while true; do
        dasterm_render_dashboard "$mode"
        echo
        printf "%bPress Ctrl+C to exit watch mode. Refreshing every %ss...%b\n" "$D_WARN" "$interval" "$D_NC"
        sleep "$interval"
      done
      ;;

    *)
      dasterm_load_all
      dasterm_error "$(dasterm_t unknown_cmd): $cmd"
      dasterm_help
      exit 1
      ;;
  esac
}

dasterm_dispatch "$@"
